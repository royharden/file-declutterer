{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["src/core", "src/adapters", "src/ui", "src/main.tsx", "src/vite-env.d.ts"],
  "exclude": ["src/engine", "supabase", "cli", "tests"]
}
